<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PopPrompt.Windows</AssemblyName>
    <RootNamespace>PopPrompt.Windows</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Starter groups shared with the macOS app. -->
    <EmbeddedResource Include="..\..\shared\default-groups.json" LogicalName="PopPrompt.Windows.default-groups.json" />
  </ItemGroup>
</Project>
