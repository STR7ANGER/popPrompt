<Window x:Class="PopPrompt.Windows.PromptEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prompt"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Group pills: the selected group is white, the rest are subtle. -->
        <Style x:Key="GroupPillStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Pill"
                                Background="#14FFFFFF"
                                CornerRadius="16"
                                Padding="12,6">
                            <TextBlock x:Name="PillText"
                                       Text="{Binding Name}"
                                       Foreground="White"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="White" />
                                <Setter TargetName="PillText" Property="Foreground" Value="Black" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="Black"
            BorderBrush="#1AFFFFFF"
            BorderThickness="1"
            CornerRadius="24"
            Padding="24">
        <StackPanel>
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="HeadingText"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock x:Name="SubtitleText"
                               Foreground="#99FFFFFF"
                               FontSize="13"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Button DockPanel.Dock="Right"
                        Content="✕"
                        IsCancel="True"
                        Background="#14FFFFFF"
                        Foreground="White"
                        Width="38"
                        Height="38"
                        Padding="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Style="{StaticResource RoundedButtonStyle}" />
            </DockPanel>

            <TextBlock Text="TITLE"
                       Margin="0,22,0,0"
                       Foreground="#B8FFFFFF"
                       FontSize="12"
                       FontWeight="SemiBold" />
            <Border Margin="0,10,0,0"
                    CornerRadius="16"
                    Background="#0FFFFFFF"
                    BorderBrush="#1AFFFFFF"
                    BorderThickness="1"
                    Padding="14,12">
                <TextBox x:Name="TitleTextBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         CaretBrush="White"
                         FontSize="14" />
            </Border>

            <TextBlock Text="CONTENT"
                       Margin="0,18,0,0"
                       Foreground="#B8FFFFFF"
                       FontSize="12"
                       FontWeight="SemiBold" />
            <Border Margin="0,10,0,0"
                    CornerRadius="18"
                    Background="#0FFFFFFF"
                    BorderBrush="#1AFFFFFF"
                    BorderThickness="1"
                    Padding="10">
                <TextBox x:Name="ContentTextBox"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         CaretBrush="White"
                         FontSize="14"
                         Height="200" />
            </Border>

            <StackPanel x:Name="GroupSection">
                <TextBlock Text="GROUP"
                           Margin="0,18,0,0"
                           Foreground="#B8FFFFFF"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <ListBox x:Name="GroupListBox"
                         Margin="0,10,0,0"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         SelectionMode="Single"
                         ItemContainerStyle="{StaticResource GroupPillStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="Cancel"
                        IsCancel="True"
                        Background="#14FFFFFF"
                        Foreground="White"
                        Height="42"
                        MinWidth="92"
                        Margin="0,0,10,0"
                        Style="{StaticResource RoundedButtonStyle}" />
                <Button x:Name="SaveButton"
                        Click="OnSaveClick"
                        Background="White"
                        Foreground="Black"
                        Height="42"
                        MinWidth="92"
                        Style="{StaticResource RoundedButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
